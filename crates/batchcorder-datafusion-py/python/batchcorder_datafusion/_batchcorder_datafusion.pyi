import typing

import pyarrow as pa

class TeeTableProvider:
    def __init__(
        self,
        reader: typing.Any,
        *,
        memory_capacity: int | None = None,
        disk_path: str | None = None,
        disk_capacity: int | None = None,
        write_policy: str = "on_insertion",
        bounding: str = "sealed",
    ) -> None: ...
    def __datafusion_table_provider__(self, session: typing.Any) -> typing.Any: ...
    @property
    def schema(self) -> pa.Schema: ...
    @property
    def scans_planned(self) -> int: ...
    @property
    def scans_executed(self) -> int: ...
    @property
    def ingested_count(self) -> int: ...
    @property
    def evicted_count(self) -> int: ...
    @property
    def upstream_exhausted(self) -> bool: ...
    @property
    def is_sealed(self) -> bool: ...
    def seal(self) -> None: ...
    def close(self) -> None: ...
